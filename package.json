{
  "name": "fitkia",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/styles/input.css -o app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i src/styles/input.css -o app.css --watch",
    "dev": "npm run build:css && npx serve .",
    "build:www": "npm run build:css && node scripts/build-www.mjs",
    "android:sync": "npm run build:www && cap sync android",
    "android:open": "cap open android",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test",
    "e2e": "node e2e/browser.cjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "sharp": "^0.35.5",
    "tailwindcss": "~3.4"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  }
}
